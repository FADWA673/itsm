# =============================================================================
# BACKEND ENVIRONMENT VARIABLES — ITSM Platform
# Copy this file to .env and fill in your values
# Never commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_NAME=ITSM Platform
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Database (MySQL + Prisma)
# -----------------------------------------------------------------------------
# In Docker: use the service name "db" as host, port 3306
# Locally:   use localhost and the mapped port (3306 by default)
DATABASE_URL="mysql://root:rootpassword@localhost:3306/itsm_db"


DB_HOST=localhost
DB_PORT=3306
DB_NAME=itsm_db
DB_USER=root
DB_PASSWORD=rootpassword
DB_ROOT_PASSWORD=rootpassword

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=your.email@gmail.com

# -----------------------------------------------------------------------------
# WhatsApp Web.js (Legacy)
# -----------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# WhatsApp Business API (Meta) - Official API
# -----------------------------------------------------------------------------
WHATSAPP_META_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_META_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_META_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_META_VERIFY_TOKEN=mySecureWebhookToken123
WHATSAPP_META_GRAPH_API_VERSION=v18.0
WHATSAPP_META_APP_SECRET=

# -----------------------------------------------------------------------------
# AI Integration (Groq - FREE!)
# -----------------------------------------------------------------------------
# Get your FREE API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
AI_PROVIDER=groq

# Alternative: OpenAI (PAID - if you want to use it later)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1500

# Legacy (keep for compatibility)
N8N_WEBHOOK_URL=
AI_API_KEY=
AI_MODEL=gpt-4

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=logs/app.log

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://172.19.0.4:5173
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
